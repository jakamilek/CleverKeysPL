+package tribixbite.cleverkeys.casing
+
+import java.util.Locale
+
+/**
+ * Pure resolver for a lexical key that has two first-letter casing surfaces.
+ *
+ * The lexical key remains case-insensitive and singular. This class only decides
+ * which already-audited surface should be primary in the suggestion projection.
+ *
+ * No sentence context is inferred here. Sentence-start auto-cap, Shift and Caps
+ * Lock remain outside this resolver.
+ */
+data class CaseVariantSet(
+    val key: String,
+    val defaultPrimary: String,
+    val alternate: String,
+) {
+    init {
+        require(key.isNotBlank()) { "key must not be blank" }
+        val folded = key.lowercase(Locale.ROOT)
+        require(key == folded) { "key must be the lowercase lexical identity" }
+        require(defaultPrimary.lowercase(Locale.ROOT) == folded) {
+            "defaultPrimary must belong to key"
+        }
+        require(alternate.lowercase(Locale.ROOT) == folded) {
+            "alternate must belong to key"
+        }
+        require(defaultPrimary != alternate) {
+            "defaultPrimary and alternate must be distinct surfaces"
+        }
+        require(
+            setOf(defaultPrimary, alternate) == setOf(
+                folded,
+                key.replaceFirstChar {
+                    if (it.isLowerCase()) it.titlecase(Locale.ROOT) else it.toString()
+                },
+            )
+        ) {
+            "the experimental resolver currently supports lowercase + first-letter-capitalized surfaces only"
+        }
+    }
+}
+
+/**
+ * Local preference counters. Persistence belongs to the runtime storage layer.
+ */
+data class CaseVariantPreference(
+    val lowercaseUses: Long = 0,
+    val capitalizedUses: Long = 0,
+) {
+    init {
+        require(lowercaseUses >= 0) { "lowercaseUses must be >= 0" }
+        require(capitalizedUses >= 0) { "capitalizedUses must be >= 0" }
+    }
+}
+
+/** Resolved presentation order. Both surfaces remain available. */
+data class CaseVariantSelection(
+    val primary: String,
+    val alternate: String,
+)
+
+/**
+ * Pure dual-casing policy.
+ *
+ * A minimum amount of evidence and a lead over the competing variant are
+ * required before changing the preferred surface. One accidental selection
+ * therefore cannot flip a user's normal spelling.
+ */
+class CaseVariantResolver(
+    private val minimumObservedUsesToSwitch: Long = 5,
+    private val minimumLeadToSwitch: Long = 2,
+) {
+    init {
+        require(minimumObservedUsesToSwitch > 0)
+        require(minimumLeadToSwitch > 0)
+    }
+
+    fun resolve(
+        variants: CaseVariantSet,
+        preference: CaseVariantPreference = CaseVariantPreference(),
+    ): CaseVariantSelection {
+        val lower = variants.key.lowercase(Locale.ROOT)
+        val capitalized = variants.key.replaceFirstChar {
+            if (it.isLowerCase()) it.titlecase(Locale.ROOT) else it.toString()
+        }
+
+        val primary = when {
+            preference.capitalizedUses >= minimumObservedUsesToSwitch &&
+                preference.capitalizedUses >= preference.lowercaseUses + minimumLeadToSwitch -> capitalized
+
+            preference.lowercaseUses >= minimumObservedUsesToSwitch &&
+                preference.lowercaseUses >= preference.capitalizedUses + minimumLeadToSwitch -> lower
+
+            else -> variants.defaultPrimary
+        }
+
+        val alternate = if (primary == lower) capitalized else lower
+        return CaseVariantSelection(primary = primary, alternate = alternate)
+    }
+}
