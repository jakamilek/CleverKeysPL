+package tribixbite.cleverkeys.casing
+
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+
+class CaseVariantResolverTest {
+
+    @Test
+    fun oneLexicalKeyExposesLowercaseAndCapitalizedSurfaces() {
+        val variants = CaseVariantSet("malina", "malina", "Malina")
+        val result = CaseVariantResolver().resolve(variants)
+        assertThat(result.primary).isEqualTo("malina")
+        assertThat(result.alternate).isEqualTo("Malina")
+    }
+
+    @Test
+    fun existingCanonicalCapitalizationCanRemainTheDefault() {
+        val variants = CaseVariantSet("warszawa", "Warszawa", "warszawa")
+        val result = CaseVariantResolver().resolve(variants)
+        assertThat(result.primary).isEqualTo("Warszawa")
+        assertThat(result.alternate).isEqualTo("warszawa")
+    }
+
+    @Test
+    fun oneAccidentalCapitalizedUseDoesNotFlipLowercaseDefault() {
+        val variants = CaseVariantSet("malina", "malina", "Malina")
+        val result = CaseVariantResolver().resolve(
+            variants,
+            CaseVariantPreference(lowercaseUses = 12, capitalizedUses = 1),
+        )
+        assertThat(result.primary).isEqualTo("malina")
+        assertThat(result.alternate).isEqualTo("Malina")
+    }
+
+    @Test
+    fun repeatedCapitalizedUseCanMakeCapitalizedSurfacePrimary() {
+        val variants = CaseVariantSet("malina", "malina", "Malina")
+        val result = CaseVariantResolver().resolve(
+            variants,
+            CaseVariantPreference(lowercaseUses = 2, capitalizedUses = 8),
+        )
+        assertThat(result.primary).isEqualTo("Malina")
+        assertThat(result.alternate).isEqualTo("malina")
+    }
+
+    @Test
+    fun repeatedLowercaseUseCanMovePreferenceBack() {
+        val variants = CaseVariantSet("malina", "malina", "Malina")
+        val result = CaseVariantResolver().resolve(
+            variants,
+            CaseVariantPreference(lowercaseUses = 8, capitalizedUses = 2),
+        )
+        assertThat(result.primary).isEqualTo("malina")
+        assertThat(result.alternate).isEqualTo("Malina")
+    }
+
+    @Test
+    fun equalEvidenceKeepsAuditedDefaultInsteadOfOscillating() {
+        val variants = CaseVariantSet("warszawa", "Warszawa", "warszawa")
+        val result = CaseVariantResolver().resolve(
+            variants,
+            CaseVariantPreference(lowercaseUses = 20, capitalizedUses = 20),
+        )
+        assertThat(result.primary).isEqualTo("Warszawa")
+        assertThat(result.alternate).isEqualTo("warszawa")
+    }
+
+    @Test(expected = IllegalArgumentException::class)
